PORT=5000

# ---- MongoDB Atlas ----
# Vector search ($vectorSearch) requires Atlas - a self-hosted community
# mongod has no search-index support and the app will refuse to start.
# Remember to allow this machine's IP under Atlas > Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=rag-cluster
MONGODB_DB_NAME=rag_db
# Collection holding the embedded text chunks (the vector index is built here).
MONGODB_COLLECTION_NAME=chunks

# ---- Ollama (local, no API key) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ---- RAG tuning ----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MAX_UPLOAD_MB=20

# ---- Resume-only upload gate ----
# Refuse any PDF that is not a resume/CV (heuristic first, local LLM for the
# ambiguous ones). Set to false to accept any document again.
RESUME_ONLY=true
# Skip the slower LLM second opinion and judge on the heuristic alone.
RESUME_LLM_CHECK=true
# Files accepted per upload / validate request.
MAX_UPLOAD_FILES=10
